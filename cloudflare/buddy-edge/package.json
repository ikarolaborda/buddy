{
  "name": "buddy-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Buddy edge Worker: single-task dashboard, progress projection, event consumers, supervision workflow, and gated diagnostics.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "types": "wrangler types --env preview --strict-vars=false",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --env preview",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:dry-run": "wrangler deploy --dry-run --env preview"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.10",
    "@cloudflare/workers-types": "5.20260915.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "^4.132.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
